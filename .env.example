# OpenRouter API Configuration (Required)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (Optional - defaults to z-ai/glm-4.6)
# Choose from available models on OpenRouter
LLM_MODEL=z-ai/glm-4.6

# Upstash Vector Configuration (Required)
# Get these from your Upstash Vector database dashboard
# Create a Vector database at https://console.upstash.com/
# Configure: Type=Dense, Embedding Model=Custom, Dimensions=3072, Metric=COSINE
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_token_here
